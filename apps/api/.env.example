# Postgres do docker-compose (porta 5442 no host)
DATABASE_URL=postgres://hts:hts@localhost:5442/hts
PORT=8787
# Account created by `pnpm --filter api db:seed` (the password stays only in .env)
SEED_NAME=
SEED_USERNAME=
SEED_EMAIL=
SEED_PASSWORD=
# Private, S3-compatible bucket for account photos (optional: without it, uploads answer 503)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
# Secret path segment of the Garmin push URL, 16+ characters (#163). Empty: the push route answers 404.
GARMIN_PUSH_SECRET=
