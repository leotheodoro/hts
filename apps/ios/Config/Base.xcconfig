// Shared by every target and configuration. Machine-specific values go in apps/ios/Local.xcconfig
// (not versioned; copy Local.xcconfig.example). `//` starts a comment in xcconfig, hence `:/$()/` in URLs.

HTS_BUNDLE_ID = com.hardtosubmit.app
HTS_DEVELOPMENT_TEAM =

// Production API on Render, with the Neon database (#20).
HTS_PRODUCTION_API_BASE_URL = https:/$()/hts-api-nrrk.onrender.com

// The simulator shares the Mac's network, so localhost reaches `pnpm dev`. A physical iPhone uses production;
// to test it against `pnpm dev`, set HTS_DEVICE_API_BASE_URL to the Mac's address in Local.xcconfig.
HTS_LOCAL_API_BASE_URL = http:/$()/localhost:8787
HTS_DEVICE_API_BASE_URL = $(HTS_PRODUCTION_API_BASE_URL)
